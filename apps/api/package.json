{
  "name": "@travel-pocket/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var DEV_USER_EMAIL:dev@example.com",
    "dev:fullstack": "wrangler dev --var DEV_USER_EMAIL:dev@example.com",
    "deploy": "wrangler deploy",
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply travel-pocket --local",
    "db:migrate:remote": "wrangler d1 migrations apply travel-pocket --remote",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@travel-pocket/shared": "workspace:*",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.7",
    "@eslint/js": "^9.39.1",
    "@travel-pocket/data": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.5",
    "wrangler": "^4.140.0"
  }
}
