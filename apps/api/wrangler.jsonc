{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-pocket-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  // No public URL of its own: the web Worker (apps/web) reaches it through a
  // service binding, so every request has passed its Cloudflare Access app.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-pocket",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    // No secrets. Declaring the (empty) list keeps `wrangler types` and
    // `wrangler dev` from picking up whatever a local .dev.vars contains.
    "required": []
  },
  "vars": {
    // Comma-separated list of origins allowed to call the API from a browser.
    "CORS_ORIGINS": "http://localhost:5173,http://localhost:4173",
    // Cloudflare Access (#5): the team domain (<team>.cloudflareaccess.com) and
    // the Application Audience (AUD) tag. While either is empty, no request
    // can authenticate with a JWT; local dev signs in as DEV_USER_EMAIL, which
    // the dev scripts pass with --var.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "dev": {
    "port": 8787
  }
}
